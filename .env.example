# Copy to .env and fill in your values. Never commit .env.
# LLM — any OpenAI-compatible endpoint (OpenAI, Together, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30

# Optional: Jaeger OTLP endpoint (leave blank to use console exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# SQLite duplicate store (default: data/invoice_store.db)
# INVOICE_DB_PATH=data/invoice_store.db
