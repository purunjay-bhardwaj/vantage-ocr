# Copy to .env and fill in your values. Never commit .env.
# LLM — any OpenAI-compatible endpoint (OpenAI, Together, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Jaeger OTLP endpoint (leave blank to use console exporter)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760
